{
  "name": "souls",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @souls/web run dev",
    "dev:api": "npm --workspace @souls/api run dev",
    "balance:smoke": "npm --workspace @souls/balance-lab run smoke",
    "balance:test": "npm --workspace @souls/balance-lab run balance",
    "balance:extended": "npm --workspace @souls/balance-lab run extended",
    "balance:catalog": "npm --workspace @souls/balance-lab run catalog",
    "balance:audit": "npm --workspace @souls/balance-lab run audit",
    "balance:audit-v071": "npm --workspace @souls/balance-lab run audit:v071",
    "balance:audit-v072": "npm --workspace @souls/balance-lab run audit:v072",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:ci": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "globals": "^16.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
